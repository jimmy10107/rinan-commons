{
  "name": "rinan-private-media",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUDIENCE": ""
  },
  "r2_buckets": [
    {"binding":"ORIGINALS","bucket_name":"replace-private-originals-bucket"},
    {"binding":"DISPLAYS","bucket_name":"replace-private-displays-bucket"}
  ],
  "d1_databases": [
    {"binding":"MEDIA_DB","database_name":"rinan-media","database_id":"REPLACE_DATABASE_ID"}
  ]
}
