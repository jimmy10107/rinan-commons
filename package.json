{
  "name": "rinan-walk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "content:build": "node scripts/build-content.mjs",
    "predev": "npm run content:build",
    "prebuild": "npm run content:build",
    "build:pages": "npm run content:build && npm run images:build && npm run check:media && GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/rinan-commons next build",
    "test:content": "node --test tests/content.test.mjs",
    "test:pages": "node --test tests/pages.test.mjs",
    "images:build": "node scripts/build-public-images.mjs",
    "check:media": "node scripts/check-public-media.mjs && node --test tests/media-privacy.test.mjs",
    "test:media-service": "node --test media-service/service.test.mjs",
    "test:plants": "node --test tests/plants.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "meshoptimizer": "0.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "走傱日南｜互動走讀"
}
